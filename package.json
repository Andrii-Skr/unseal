{
  "name": "unseal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:mob": "next dev --hostname $(ipconfig getifaddr en0) --port 3010",
    "dev:phone": "pnpm dev:mob",
    "build": "next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm test:db:prepare",
    "test": "vitest run",
    "pretest:watch": "pnpm test:db:prepare",
    "test:watch": "vitest",
    "pretest:e2e": "pnpm test:db:prepare --e2e",
    "test:e2e": "playwright test",
    "test:db:prepare": "tsx scripts/prepare-test-database.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
